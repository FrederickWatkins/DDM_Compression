import { Button, ComboBox } from "std-widgets.slint";
import { MainContent } from "main-content.slint";
import { StatusBar } from "status-bar.slint";
import { ProgressBar, TaskInfo } from "components/progress-bar.slint";

export enum FileType { l0b-archive, image, benchmark-results }
export enum RunAction { benchmark }

export component MainWindow inherits Window {
    title: "DDM Workbench";
    preferred-width: 1200px;
    preferred-height: 800px;

    in property <[TaskInfo]> tasks;

    callback open-file(FileType);
    callback export-file(FileType);
    callback run-action(RunAction);

    MenuBar {
        Menu {
            title: "File";
            Menu {
                title: "Open";
                MenuItem {
                    title: "L0b data archive";
                    activated => root.open-file(FileType.l0b-archive);
                }

                MenuItem {
                    title: "Image";
                    activated => root.open-file(FileType.image);
                }

                MenuItem {
                    title: "Benchmark results";
                    activated => root.open-file(FileType.benchmark-results);
                }
            }

            Menu {
                title: "Export";
                MenuItem {
                    title: "L0b data archive";
                    activated => root.export-file(FileType.l0b-archive);
                }

                MenuItem {
                    title: "Benchmark results";
                    activated => root.export-file(FileType.benchmark-results);
                }
            }
        }

        Menu {
            title: "Run";
            MenuItem {
                title: "Benchmark";
                activated => root.run-action(RunAction.benchmark);
            }
        }
    }

    VerticalLayout {
        MainContent {
            vertical-stretch: 1;
        }

        StatusBar {
            tasks: tasks;
        }
    }
}
