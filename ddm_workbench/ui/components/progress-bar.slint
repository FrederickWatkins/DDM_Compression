import {
    ProgressIndicator,
    HorizontalBox,
    VerticalBox,
} from "std-widgets.slint";

export struct TaskInfo {
    id: int,
    name: string,
    progress: percent,
}

export component ProgressBar inherits Rectangle {
    in property <TaskInfo> task;

    HorizontalLayout {
        padding: 4px;
        alignment: start;

        VerticalLayout {
            padding: 4px;
            alignment: center;
            Text {
                text: task.name;
                font-size: 12px;
            }
        }

        VerticalLayout {
            padding: 4px;
            alignment: center;

            ProgressIndicator {
                preferred-width: 80px;
                preferred-height: 10px;
                vertical-stretch: 0;
                progress: task.progress;
            }
        }
    }
}
