import { Palette } from "std-widgets.slint";
export component PlayPauseButton inherits Rectangle {
    in-out property <bool> playing;
    in property <length> size;
    width: size;
    height: size;

    Image {
        width: size;
        height: size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: playing
            ? @image-url("../../assets/pause.svg")
            : @image-url("../../assets/play.svg");
        colorize: touch-area.has-hover ? Palette.control-foreground : Palette.selection-foreground;
    }

    touch-area := TouchArea {
        mouse-cursor: pointer;

        clicked => {
            playing = !playing;
        }
    }
}
