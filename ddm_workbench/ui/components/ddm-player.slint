import { Sidebar } from "sidebar.slint";
import {
    PlaybackControls,
    PlaybackState,
    PlaybackConfig,
} from "playback-controls.slint";
import { Palette } from "std-widgets.slint";

export component DdmPlayer inherits Rectangle {
    in-out property <PlaybackState> state;
    in-out property <PlaybackConfig> config;

    HorizontalLayout {
        spacing: 0px;

        Sidebar {
            width: 250px;
            horizontal-stretch: 0;

            VerticalLayout {
                alignment: start;

                PlaybackControls {
                    state: state;
                    config: config;
                    padding: 4px;
                }
            }
        }

        Rectangle {
            border-color: Palette.border;
            border-radius: 8px;
            border-width: 2px;
            horizontal-stretch: 1;
        }
    }
}
