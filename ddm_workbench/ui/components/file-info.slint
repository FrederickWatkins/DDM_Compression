export component FileInfo inherits VerticalLayout {
    in property <string> file-name;
    in property <string> packet-summary;
    in property <string> format-summary;
    in property <string> channel-summary;
    in property <string> timestamp-summary;

    Text { text: root.file-name; }
    Text { text: root.packet-summary; }
    Text { text: root.format-summary; }
    Text { text: root.channel-summary; }
    Text { text: root.timestamp-summary; }
}
