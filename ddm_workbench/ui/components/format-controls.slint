import { ComboBox, Slider, CheckBox } from "std-widgets.slint";
export struct FormatConfig {
    format: string,
    quantisation: int,
    wavelet-stages: int,
    dc-adjust: bool,
}

export component FormatControls inherits Rectangle {
    in-out property <FormatConfig> config;

    VerticalLayout {
        alignment: start;
        padding: 10px;

        HorizontalLayout {
            padding: 10px;
            spacing: 10px;
            ComboBox {
                preferred-width: 100px;
                model: ["MP00", "MQ00"];
                current-value: config.format;
            }


            Slider {
                preferred-width: 300px;
                minimum: 0;
                maximum: 15;
                value: config.quantisation;
            }
        }

        HorizontalLayout {
            padding: 10px;
            spacing: 10px;

            CheckBox {
                text: "DC adjust";
                checked: config.dc-adjust;
            }

            Slider {
                preferred-width: 300px;
                minimum: 0;
                maximum: 15;
                value: config.wavelet-stages;
            }
        }
    }
}