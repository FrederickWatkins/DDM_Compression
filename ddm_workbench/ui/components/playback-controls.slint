import { Slider, Button, ComboBox, Palette } from "std-widgets.slint";
import { PlayPauseButton } from "play-pause-button.slint";
import { LabelledBox } from "labelled-box.slint";

export struct PlaybackState {
    playback-speed: float,
    current-timestamp: int,
    channel: string,
    all-channels: bool,
    playing: bool,
}

export struct PlaybackConfig {
    start-time: int,
    end-time: int,
    available-channels: [string],
}

export component PlaybackControls inherits Rectangle {
    in-out property <PlaybackState> state;
    in property <PlaybackConfig> config;
    border-color: Palette.border;
    border-width: 2px;
    border-radius: 8px;

    VerticalLayout {
        alignment: start;
        padding: 10px;

        HorizontalLayout {
            padding: 10px;
            spacing: 10px;
            PlayPauseButton {
                size: 32px;
            }

            LabelledBox {
                text: "Channel:";
                ComboBox {
                    preferred-width: 200px;
                    model: config.available-channels;
                    current-value: state.channel;
                    enabled: !state.all-channels;
                }
            }
        }

        HorizontalLayout {
            padding: 10px;

            LabelledBox {
                text: "Timestamp: " + state.current-timestamp;
                Slider {
                    preferred-width: 300px;
                    minimum: config.start-time;
                    maximum: config.end-time;
                    value: state.current-timestamp;
                }
            }

            spacing: 10px;

            LabelledBox {
                text: "Playback speed: " + state.playback-speed + " FPS";
                Slider {
                    preferred-width: 200px;
                    minimum: 1.0;
                    maximum: 60.0;
                    value: state.playback-speed;
                }
            }
        }
    }
}
